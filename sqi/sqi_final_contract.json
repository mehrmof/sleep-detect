    "ba_upper": 16.08942724703779,
    "max_abs_error": 22.233644859813083
  },
  "limitations": [
    "No direct sleep-quality ground-truth label",
    "Project-defined weights",
    "Project-defined knots",
    "Nonclinical qualitative bands",
    "File-span TIB proxy",
    "Lights-off assumption for SOL",
