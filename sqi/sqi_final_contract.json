  "input_contract": {
    "stage_priority": [
      "pred",
      "label",
      "stage"
    ],
    "accepted_names": [
      "W",
      "WAKE",
      "N1",
      "N2",
      "N3",
      "REM",
      "R"
    ],
    "probability_columns": [
      "prob_W",
      "prob_N1",
      "prob_N2",
      "prob_N3",
      "prob_REM"
    ],
    "probability_tolerance": 1e-06,
    "onsets": "finite and strictly increasing; no sorting/deduplication",
    "epoch_duration": "explicit epoch_sec else median positive onset step else 30 s",
    "hard_stage_first": true
  },
  "temporal": {
    "tib": "supplied recording/window span proxy",
    "onset": "first sleep epoch with next 600 s containing >=50% sleep and >=round(600/epoch_sec) epochs",
    "final_awakening": "last sleep epoch with preceding 600 s containing >=50% sleep and minimum count",
    "spt": "onset through end of final qualifying sleep epoch",
    "tst": "N1+N2+N3+REM minutes inside SPT",
    "waso": "Wake minutes inside SPT",
    "sol": "window start to qualifying onset",
    "stage_percent_denominator": "TST",
    "rem_latency": "sleep onset to first REM inside SPT",
    "sfi": "clock-adjacent differing scored-stage pairs per SPT hour",
    "wake_bouts": "clock-adjacent Wake runs per SPT hour"
  },
  "refusal_rules": [
    {
      "condition": "window<180 min or end<=start",
      "reason": "window_too_short"
    },
    {
      "condition": "unscored_fraction>0.25",
      "reason": "unknown_fraction"
    },
    {
      "condition": "no qualifying onset/final awakening",
      "reason": "no_sleep"
    },
    {
      "condition": "SPT<60 min or scored coverage<0.70",
      "reason": "spt_coverage_low"
    },
    {
      "condition": "TST<=0",
      "reason": "no_sleep"
    }
  ],
  "descriptive_bands": {
    "poor": "<50",
    "fair": "50-<70",
    "good": "70-<85",
    "excellent": ">=85",
    "status": "descriptive/nonclinical"
  },
  "knot_evidence_counts": {
    "counting_rule": "22 nontrivial x-thresholds; domain guard endpoints excluded",
    "DIRECTLY_CITED": 7,
    "LITERATURE_INFORMED_PROJECT_ASSUMPTION": 4,
    "PROJECT_ASSUMPTION": 11
  },
  "weights_fixed_before_validation": true,
  "primary_validation": {
    "population": "80 development subjects; 157 candidate recordings; sealed overlap zero",
    "paired_n": 156,
    "refusal": "SC4092E0-PSG unknown_fraction",
    "mae": 5.353162616339118,
    "bias": 1.743236317278342,
    "spearman": 0.8814306712395884,
